{
  "name": "media-manager",
  "private": true,
  "version": "0.0.1",
  "type": "commonjs",
  "author": "HiroYuno",
  "main": "dist/main/main.js",
  "scripts": {
    "dev:renderer": "vite",
    "dev:main": "tsc -p tsconfig.main.json --watch",
    "dev:electron": "wait-on http://localhost:5173 && cross-env NODE_ENV=development electronmon dist/main/main.js",
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:main\" \"npm:dev:electron\"",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "start": "npm run build && cross-env NODE_ENV=production electron dist/main/main.js",
    "dist:win": "npm run build && electron-builder build --win"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electronmon": "^2.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "wait-on": "^9.1.0"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true
  }
}
