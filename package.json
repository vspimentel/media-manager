{
  "name": "media-manager",
  "productName": "Media Manager",
  "private": true,
  "version": "0.0.1",
  "type": "commonjs",
  "author": "HiroYuno",
  "main": "dist/main/main.js",
  "scripts": {
    "dev:renderer": "vite",
    "dev:main": "tsc -p tsconfig.main.json --watch",
    "dev:electron": "wait-on http://localhost:5173 && cross-env NODE_ENV=development electronmon dist/main/main.js",
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:main\" \"npm:dev:electron\"",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build": "npm run clean && npm run build:main && npm run build:renderer",
    "start": "npm run build && cross-env NODE_ENV=production electron dist/main/main.js",
    "dist:win": "npm run build && electron-builder build --win",
    "clean": "rimraf dist dist-renderer releases"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/ffprobe-static": "^2.0.3",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.11",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electronmon": "^2.0.4",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "wait-on": "^9.1.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.102.3",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.0",
    "drizzle-orm": "^0.45.4",
    "get-video-duration": "^5.0.0",
    "lucide-react": "^1.64.0",
    "p-limit": "^7.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "better-sqlite3@13.0.3": true,
    "esbuild@0.18.20": true
  },
  "imports": {
    "#components/*": "./src/renderer/components/*.tsx",
    "#lib/*": "./src/renderer/lib/*.ts",
    "#hooks/*": "./src/renderer/hooks/*.ts"
  }
}
