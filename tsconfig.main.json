{
  "compilerOptions": {
    "strict": true,
    "target": "ESNext",
    "module": "NodeNext",
    "rootDir": "src",
    "outDir": "dist",
    "skipLibCheck": true,
    "types": ["node"],
    "composite": true,
    "tsBuildInfoFile": "./dist/tsbuildinfo"
  },
  "include": ["src/main/**/*", "src/preload/**/*", "src/global.d.ts"]
}
